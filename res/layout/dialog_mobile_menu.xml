<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mobile_menu_dialog"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Quick Action Icons (Back, Forward, Reload, Star Bookmark, Share) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_mobile_omnibox"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <Button
            android:id="@+id/menuBtnBack"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mobile_icon_button"
            android:text="◀"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/menuBtnForward"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mobile_icon_button"
            android:text="▶"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/menuBtnReload"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mobile_icon_button"
            android:text="🔄"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/menuBtnStar"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mobile_icon_button"
            android:text="⭐"
            android:textColor="@color/accent_cyan"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="@color/border_omnibox" />

    <!-- Scrollable Options List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="380dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Nov zavihek -->
            <LinearLayout
                android:id="@+id/rowMenuNewTab" android:focusable="true" android:clickable="true" android:descendantFocusability="blocksDescendants"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_mobile_icon_button"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="➕" android:textSize="16sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/menu_new_tab" android:textColor="@color/text_primary" android:textSize="14sp" />
            </LinearLayout>

            <!-- Zaznamki -->
            <LinearLayout
                android:id="@+id/rowMenuSafeerLink" android:focusable="true" android:clickable="true" android:descendantFocusability="blocksDescendants"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_mobile_icon_button"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔗" android:textSize="16sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/menu_safeer_link" android:textColor="@color/text_primary" android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowMenuBookmarks" android:focusable="true" android:clickable="true" android:descendantFocusability="blocksDescendants"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_mobile_icon_button"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📖" android:textSize="16sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/menu_bookmarks" android:textColor="@color/text_primary" android:textSize="14sp" />
            </LinearLayout>

            <!-- Prenosi -->
            <LinearLayout
                android:id="@+id/rowMenuDownloads" android:focusable="true" android:clickable="true" android:descendantFocusability="blocksDescendants"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_mobile_icon_button"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📥" android:textSize="16sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/menu_downloads" android:textColor="@color/text_primary" android:textSize="14sp" />
            </LinearLayout>

            <!-- Zgodovina -->
            <LinearLayout
                android:id="@+id/rowMenuHistory" android:focusable="true" android:clickable="true" android:descendantFocusability="blocksDescendants"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_mobile_icon_button"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🕒" android:textSize="16sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/menu_history" android:textColor="@color/text_primary" android:textSize="14sp" />
            </LinearLayout>


            <!-- Namizno spletno mesto (Toggle) -->
            <LinearLayout
                android:id="@+id/rowMenuDesktopSite" android:focusable="true" android:clickable="true" android:descendantFocusability="blocksDescendants"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_mobile_icon_button"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🖥️" android:textSize="16sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/menu_desktop_site" android:textColor="@color/text_primary" android:textSize="14sp" />
                <CheckBox android:id="@+id/cbDesktopSite" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="false" />
            </LinearLayout>

            <!-- Threat Shield Pregled (Feodo/URLhaus) -->
            <LinearLayout
                android:id="@+id/rowMenuThreatStats" android:focusable="true" android:clickable="true" android:descendantFocusability="blocksDescendants"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_mobile_icon_button"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛑" android:textSize="16sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/menu_threat_stats" android:textColor="@color/text_primary" android:textSize="14sp" />
                <TextView android:id="@+id/tvThreatCountBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#ff5555" android:textSize="12sp" android:text="@string/ui_shield_active" />
            </LinearLayout>

            <!-- AdBlock Ščit (Toggle) -->
            <LinearLayout
                android:id="@+id/rowMenuAdBlock" android:focusable="true" android:clickable="true" android:descendantFocusability="blocksDescendants"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_mobile_icon_button"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛡️" android:textSize="16sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/menu_adblock" android:textColor="@color/text_primary" android:textSize="14sp" />
                <CheckBox android:id="@+id/cbAdBlock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:clickable="false" />
            </LinearLayout>

            <!-- AMOLED Temni način (Toggle) -->
            <LinearLayout
                android:id="@+id/rowMenuDarkMode" android:focusable="true" android:clickable="true" android:descendantFocusability="blocksDescendants"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_mobile_icon_button"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌙" android:textSize="16sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/menu_dark_mode" android:textColor="@color/text_primary" android:textSize="14sp" />
                <CheckBox android:id="@+id/cbDarkMode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:clickable="false" />
            </LinearLayout>

            <!-- SponsorBlock (Toggle) -->
            <LinearLayout
                android:id="@+id/rowMenuSponsorBlock" android:focusable="true" android:clickable="true" android:descendantFocusability="blocksDescendants"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_mobile_icon_button"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏭" android:textSize="16sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/menu_sponsorblock" android:textColor="@color/text_primary" android:textSize="14sp" />
                <CheckBox android:id="@+id/cbSponsorBlock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:clickable="false" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
